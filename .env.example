# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (path to the SQLite file; defaults to tmp/db.sqlite3)
# DB_FILENAME=tmp/db.sqlite3

# Reader context (directory of living markdown docs about you; defaults to ./context)
# READER_CONTEXT_DIR=context

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Newspaper schedule
#--------------------------------------------------------------------
# Time of day (24-hour HH:mm) the daily pipeline runs. Defaults to 21:00.
# NEWSPAPER_RUN_TIME=21:00
# Set to false to run API-only (no daily email). Defaults to true.
# EMAIL_ENABLED=true

#--------------------------------------------------------------------
# Email delivery (SMTP, via Resend)
#--------------------------------------------------------------------
# The edition is emailed over SMTP through Resend. Only the API key is required;
# host, port and username default to Resend's values below.
RESEND_API_KEY=
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# The sender address (defaults to newspaper@percussionlabs.ai).
# SMTP_FROM=newspaper@percussionlabs.ai
# Where the daily edition is sent.
# EMAIL_RECIPIENT=you@example.com
# The reader's name, used to greet them in the email (defaults to "there").
# EMAIL_RECIPIENT_NAME=Ada

#--------------------------------------------------------------------
# Language models
#--------------------------------------------------------------------
# Each task picks its own provider (anthropic or openai) and model, so they can
# be mixed — e.g. rank with Claude and summarise with OpenAI. Only set the API
# keys for the providers you actually use. Defaults:
#   ranking -> claude-haiku-4-5 (anthropic)
#   summary -> gpt-5-mini-2025-08-07, generation -> gpt-5.4-2026-03-05 (openai)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_RANKING_PROVIDER=anthropic
# LLM_RANKING_MODEL=claude-haiku-4-5
# LLM_SUMMARY_PROVIDER=openai
# LLM_SUMMARY_MODEL=gpt-5-mini-2025-08-07
# LLM_GENERATION_PROVIDER=openai
# LLM_GENERATION_MODEL=gpt-5.4-2026-03-05

#--------------------------------------------------------------------
# Content discovery
#--------------------------------------------------------------------
# YOUTUBE_API_KEY=
# WEBSEARCH_API_KEY=
# X (Twitter) API bearer token, for reading posts from configured accounts.
# X_API_KEY=

#--------------------------------------------------------------------
# Telegram link ingestion (long-polling bot)
#--------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# Only this chat id may submit links.
# TELEGRAM_ALLOWED_CHAT_ID=
QUEUE_REDIS_HOST=127.0.0.1
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=