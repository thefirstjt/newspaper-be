# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (path to the SQLite file; defaults to tmp/db.sqlite3)
# DB_FILENAME=tmp/db.sqlite3

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Newspaper schedule
#--------------------------------------------------------------------
# Time of day (24-hour HH:mm) the daily pipeline runs. Defaults to 21:00.
# NEWSPAPER_RUN_TIME=21:00
# Set to false to run API-only (no daily email). Defaults to true.
# EMAIL_ENABLED=true

#--------------------------------------------------------------------
# Email delivery (SMTP)
#--------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=your-newspaper@example.com
# EMAIL_RECIPIENT=you@example.com

#--------------------------------------------------------------------
# Language model (ranking, summaries, key learning, quiz)
#--------------------------------------------------------------------
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# Optional per-task model overrides; each falls back to a provider default.
# LLM_MODEL_RANKING=
# LLM_MODEL_SUMMARY=
# LLM_MODEL_GENERATION=

#--------------------------------------------------------------------
# Content discovery
#--------------------------------------------------------------------
# YOUTUBE_API_KEY=
# WEBSEARCH_API_KEY=

#--------------------------------------------------------------------
# Telegram link ingestion (long-polling bot)
#--------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# Only this chat id may submit links.
# TELEGRAM_ALLOWED_CHAT_ID=